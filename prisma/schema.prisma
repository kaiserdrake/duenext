generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum Visibility {
  PRIVATE
  SHARED
  CUSTOM
}

enum Channel {
  EMAIL
  NTFY
}

enum Recurrence {
  MONTHLY
  YEARLY
}

enum TaskType {
  SHORT
  LONG
  FREE
}

enum TaskStatus {
  QUEUED
  ACTIVE
  DONE
}

enum TaskPhase {
  WORK
  REST
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  role            Role     @default(USER)
  isActive        Boolean  @default(true)

  ntfyServerUrl   String?
  ntfyTopic       String?
  ntfyAccessToken String?
  notifyByEmail   Boolean  @default(true)
  notifyByNtfy    Boolean  @default(false)

  // SHA-256 hash of the user's personal API token (never store the raw
  // token - it's only ever shown once, at generation time). One active
  // token per user; regenerating replaces it, invalidating the old one.
  apiTokenHash    String?  @unique

  // Opt-in focus-timer task board on the dashboard. Off by default; turning
  // it off again keeps the user's tasks around for when it's re-enabled.
  taskBoardEnabled Boolean @default(false)

  items           Item[]
  reminderLogs    ReminderLog[]
  sharedItems     ItemShare[]
  hiddenItems     ItemHide[]
  tasks           Task[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Item {
  id              String        @id @default(cuid())
  title           String
  category        String?
  dueDate         DateTime      @db.Date
  // Optional "HH:mm" (24h) - a time of day for the due date, e.g. an
  // appointment. When set, reminders are computed against this exact
  // moment (in REMINDER_TIMEZONE); when absent, the item is treated as
  // due at 00:00 that day.
  dueTime         String?
  notes           String?
  visibility      Visibility    @default(PRIVATE)
  // Minutes before the due date/time to send a reminder (e.g. 1440 = 1 day,
  // 60 = 1 hour, 15 = 15 minutes). Negative values remind after.
  reminderOffsetsMinutes Int[]  @default([43200, 20160, 10080, 1440, 0])
  // When set, the reminder job rolls dueDate forward by one cycle (and
  // clears stale reminder logs) once the item goes overdue, instead of
  // leaving it sitting in Overdue - e.g. a yearly birthday.
  recurrence      Recurrence?
  completedAt     DateTime?

  owner           User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String

  reminderLogs    ReminderLog[]
  sharedWith      ItemShare[]
  hiddenBy        ItemHide[]

  // Set on the "Action Item" mirror of a task-board card that has a
  // deadline (see lib/tasks.ts syncTaskItem). Such items are managed from
  // the task board, not edited here. Nulled (not deleted) when the task is
  // cleared out of Done, so the completed item stays in the archive.
  task            Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId          String?       @unique

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([ownerId])
  @@index([dueDate])
  @@index([visibility])
}

// A user dismissing an overdue item from their own dashboard ("hold to
// hide"). Per user, since shared items show up for several people. Pinned to
// the due date it was hidden at: only counts while item.dueDate still equals
// it, so rescheduling (or a recurrence rolling forward) brings it back.
model ItemHide {
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  dueDate   DateTime @db.Date

  createdAt DateTime @default(now())

  @@id([itemId, userId])
  @@index([userId])
}

// Explicit grantee list, only populated/consulted when Item.visibility = CUSTOM.
model ItemShare {
  id        String   @id @default(cuid())
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([itemId, userId])
  @@index([userId])
}

// One row per (item, offset, channel, recipient) - dedupes sends per user,
// which matters once SHARED/CUSTOM items fan out reminders to every viewer.
model ReminderLog {
  id            String   @id @default(cuid())
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  offsetMinutes Int
  channel       Channel
  sentAt        DateTime @default(now())

  @@unique([itemId, userId, offsetMinutes, channel])
  @@index([itemId])
  @@index([userId])
}

// A card on the dashboard task board (Pomodoro-style focus timer). Private to
// its owner. At most one per user is ACTIVE; its running phase is stored
// here rather than in the browser so a reload (or another device) picks the
// timer up where it left off.
model Task {
  id             String     @id @default(cuid())
  title          String
  notes          String?
  type           TaskType   @default(SHORT)
  status         TaskStatus @default(QUEUED)
  // Queue position (lower sorts first, i.e. higher priority).
  sortOrder      Int        @default(0)
  // Only set while ACTIVE: which phase is running and since when.
  phase          TaskPhase?
  phaseStartedAt DateTime?
  // Total work time banked across sessions, and finished work phases.
  workedSeconds  Int        @default(0)
  rounds         Int        @default(0)
  completedAt    DateTime?
  // Optional deadline. When set, the task also shows on the appointments
  // side as an "Action Item" (the linked `item`).
  dueDate        DateTime?  @db.Date
  dueTime        String?
  item           Item?
  // Blurred on the dashboard while privacy mode is on (see lib/privacy.ts).
  isPrivate      Boolean    @default(false)

  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId        String

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([ownerId, status])
}
