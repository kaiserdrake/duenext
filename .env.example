# ---- Database ----
POSTGRES_USER=duenext
POSTGRES_PASSWORD=change_me
POSTGRES_DB=duenext
DATABASE_URL=postgresql://duenext:change_me@duenext-db:5432/duenext

# ---- App ----
APP_PORT=3000
APP_URL=http://localhost:3000
AUTH_SECRET=change_me_generate_with_openssl_rand_base64_32
# Required for self-hosting: Auth.js only trusts the request's Host header
# automatically on Vercel. Everywhere else (including behind a reverse proxy),
# this must be set to true.
AUTH_TRUST_HOST=true
REMINDER_TIMEZONE=UTC

# ---- Initial admin (created on first boot if no matching user exists) ----
# ADMIN_EMAIL is the login name - it doesn't have to be a real email address
# (e.g. "admin" works). It only needs to be one if this account should also
# receive email reminders.
ADMIN_EMAIL=admin
ADMIN_PASSWORD=change_me

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DueNext <duenext@example.com>"

# ---- Ntfy default server (topic + access token are set per-user in profile) ----
# If your server has no access control, duenext auto-generates a long random
# topic per user rather than a guessable one (anyone who knows a topic name
# can read and publish to it).
DEFAULT_NTFY_URL=

# ---- Docker host data path ----
DUENEXT_DATA_PATH=./appdata
